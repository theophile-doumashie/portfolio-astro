---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Articles — Théophile Doumashie"
			description="Notes techniques sur la téléphonie IP, les centres de contacts et la sécurité des serveurs Linux, par un ingénieur VoIP basé à Lomé."
		/>
		<style is:inline>
			.blog-main {
				max-width: 1240px;
				margin: 0 auto;
				padding: clamp(48px, 10vh, 120px) clamp(16px, 4vw, 40px);
			}
			.blog-title {
				margin: 0 0 clamp(26px, 5vh, 44px);
				font-size: clamp(40px, 7.4vw, 104px);
				line-height: .92;
				letter-spacing: -0.042em;
				text-transform: uppercase;
			}
			.blog-intro {
				margin: 0 0 clamp(32px, 6vh, 56px);
				max-width: 52ch;
				font-size: clamp(17px, 1.8vw, 21px);
				line-height: 1.35;
				font-weight: 600;
				text-wrap: pretty;
			}
			.blog-list {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 2px solid var(--color-divider);
			}
			.blog-list li { border-bottom: 2px solid var(--color-divider); }
			.blog-list a {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 12px clamp(20px, 3vw, 40px);
				align-items: baseline;
				padding: clamp(20px, 3vh, 32px) 4px;
				text-decoration: none;
				color: var(--color-text);
				transition: padding-left .3s cubic-bezier(.2,.7,.2,1), color .2s;
			}
			.blog-list a:hover { padding-left: 18px; color: var(--color-accent); }
			.blog-list h2 {
				margin: 0;
				font-size: clamp(22px, 3.2vw, 38px);
				line-height: 1.06;
				letter-spacing: -0.02em;
				text-wrap: balance;
			}
			.blog-list .resume {
				grid-column: 1 / -1;
				margin: 0;
				max-width: 62ch;
				font-size: 15px;
				color: var(--color-neutral-700);
				text-wrap: pretty;
			}
			.blog-vide {
				margin: 0;
				font-size: 15px;
				color: var(--color-neutral-700);
			}
			@media (max-width: 640px) {
				.blog-list a { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="blog-main">
			<h1 class="blog-title" data-reveal>Articles<span class="section-num">06</span></h1>

			<p class="blog-intro">
				Des notes de terrain sur la téléphonie IP, les centres de contacts
				et la sécurité des serveurs Linux. Ce que j'aurais aimé trouver en
				français quand j'ai commencé.
			</p>

			{posts.length === 0 ? (
				<p class="blog-vide">Aucun article publié pour le moment.</p>
			) : (
				<ul class="blog-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h2>{post.data.title}</h2>
								<span class="mono"><FormattedDate date={post.data.pubDate} /></span>
								{post.data.description && (
									<p class="resume">{post.data.description}</p>
								)}
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>